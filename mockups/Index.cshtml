@page
@{
    ViewData["Title"] = "Advisor Workspace";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KBC Advisor Workspace</title>
    <style>
            :root {
                --kbc-blue: #00a0dc;
                --kbc-dark-blue: #003057;
                --kbc-light-blue: #dcf2fa;
                --text-main: #333333;
                --text-muted: #666666;
                --bg-gray: #f5f7f9;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            }

            body, html {
                height: 100%;
                background-color: var(--bg-gray);
                overflow: hidden;
            }

            /* Top Window Bar (Simulated App Header) */
            .app-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                background-color: #ffffff;
                padding: 8px 16px;
                border-bottom: 1px solid #e0e0e0;
                font-size: 13px;
            }

            .header-logo {
                font-weight: 900;
                color: var(--kbc-dark-blue);
                font-size: 18px;
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .header-logo-icon {
                color: var(--kbc-blue);
                font-size: 14px;
            }

            .header-title {
                color: var(--text-main);
            }

            .header-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .advisor-info {
                display: flex;
                align-items: center;
                gap: 8px;
                color: var(--text-main);
            }

            .advisor-avatar {
                width: 24px;
                height: 24px;
                background-color: #ccc;
                border-radius: 50%;
                overflow: hidden;
            }

            .window-controls {
                display: flex;
                gap: 12px;
                color: var(--text-muted);
            }

            /* Workspace Area */
            .workspace-area {
                position: relative;
                height: calc(100vh - 45px);
                display: flex;
                justify-content: center;
                align-items: center;
                /* Placeholder blurred background effect */
                background: linear-gradient(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.7)), url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1920&q=80') center/cover;
                backdrop-filter: blur(8px);
            }

            /* Floating Right Panel */
            .floating-right-panel {
                position: absolute;
                top: 24px;
                right: 24px;
                background: white;
                border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                padding: 12px;
                width: 200px;
            }

            .floating-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 12px;
                color: var(--text-main);
                margin-bottom: 12px;
            }

            .status-dot {
                width: 8px;
                height: 8px;
                background-color: #4caf50;
                border-radius: 50%;
            }

            .context-doc-btn {
                background-color: var(--kbc-light-blue);
                border-radius: 6px;
                padding: 8px;
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 12px;
                color: var(--kbc-dark-blue);
                border: 1px solid #bce2f5;
            }

            .info-icon-circle {
                background-color: var(--kbc-blue);
                color: white;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                display: flex;
                justify-content: center;
                align-items: center;
                font-weight: bold;
            }

            /* Main Client Profile Panel */
            .insight-panel {
                background: #ffffff;
                border-radius: 12px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.15);
                width: 600px;
                padding: 24px 32px;
                display: flex;
                flex-direction: column;
                gap: 16px;
                position: relative;
            }

            .panel-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .panel-title {
                font-size: 18px;
                color: var(--text-main);
                font-weight: 500;
            }

            .copy-icon {
                color: var(--text-muted);
                cursor: pointer;
            }

            .section-title {
                font-size: 14px;
                font-weight: 600;
                color: var(--text-main);
                margin-bottom: 6px;
            }

            /* Core Context */
            .context-pill {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background-color: var(--kbc-light-blue);
                color: var(--kbc-dark-blue);
                padding: 6px 12px;
                border-radius: 6px;
                font-weight: 600;
                font-size: 13px;
            }

            .confidence-row {
                font-size: 13px;
                color: var(--text-main);
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 4px;
            }

            .ring-icon {
                color: var(--kbc-blue);
                width: 16px;
                height: 16px;
            }

            /* Detected Signals */
            .signals-list {
                list-style: none;
            }

                .signals-list li {
                    font-size: 14px;
                    color: var(--text-main);
                    margin-bottom: 4px;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

            .check-icon {
                color: var(--kbc-blue);
                width: 16px;
                height: 16px;
            }

            /* Suggested Services */
            .services-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px 16px;
            }

            .service-item {
                font-size: 13px;
                color: var(--text-main);
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .service-icon {
                color: var(--text-muted);
                width: 14px;
                height: 14px;
            }

            /* Next Action */
            .next-action-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 8px;
            }

            .action-label {
                font-size: 14px;
                color: var(--text-main);
            }

            .action-buttons {
                display: flex;
                gap: 12px;
            }

            .btn {
                background-color: #3e82b3;
                color: white;
                border: none;
                padding: 8px 16px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
                cursor: pointer;
                transition: background 0.2s;
            }

                .btn:hover {
                    background-color: #2c6894;
                }

            .expand-arrow {
                text-align: center;
                color: var(--text-muted);
                margin-top: 8px;
                cursor: pointer;
            }

    </style>
</head>
<body>

    <!-- Fake App Header -->
    <div class="app-header">
        <div class="header-logo">
            <span class="header-logo-icon">▲</span> KBC
        </div>
        <div class="header-title">KBC Advisor Workspace</div>
        <div class="header-right">
            <div class="advisor-info">
                Advisor: Andre
                <div class="advisor-avatar">
                    <svg viewBox="0 0 24 24" fill="#666"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                </div>
            </div>
            <div class="window-controls">
                <span>-</span>
                <span>□</span>
                <span>✕</span>
            </div>
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="workspace-area">

        <!-- Floating Right Panel -->
        <div class="floating-right-panel">
            <div class="floating-header">
                <div style="display:flex; align-items:center; gap:6px;">
                    <div class="advisor-avatar" style="width:16px; height:16px;">
                        <svg viewBox="0 0 24 24" fill="#666"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                    </div>
                    Adviseur: Andre
                </div>
                <div class="status-dot"></div>
            </div>
            <div class="context-doc-btn">
                <div class="info-icon-circle">i</div>
                Context<br>Documentation
            </div>
        </div>

        <!-- Central Insight Panel -->
        <div class="insight-panel">
            <div class="panel-header">
                <div class="panel-title">Client Profile: Jan Janssens (Client Number: 10294)</div>
                <div class="copy-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                </div>
            </div>

            <div>
                <div class="section-title">Core Context</div>
                <div class="context-pill">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                    HOME PURCHASE DETECTED
                </div>
                <div class="confidence-row">
                    Confidence: 87%
                    <svg class="ring-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M22 12A10 10 0 1 1 12 2"></path></svg>
                </div>
            </div>

            <div>
                <div class="section-title">Detected Signals:</div>
                <ul class="signals-list">
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" /></svg>
                        Furniture spending increased
                    </li>
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" /></svg>
                        Repeated spending in Ghent
                    </li>
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" /></svg>
                        Home-improvement purchases
                    </li>
                </ul>
            </div>

            <div>
                <div class="section-title">Suggested KBC Services:</div>
                <div class="services-grid">
                    <div class="service-item">
                        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        Home insurance
                    </div>
                    <div class="service-item">
                        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                        Mortgage Review
                    </div>
                    <div class="service-item">
                        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                        Mortgage Review
                    </div>
                    <div class="service-item">
                        <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                        Moving Checklist & Services
                    </div>
                </div>
            </div>

            <div class="section-title" style="margin-bottom: 0;">Next Action:</div>
            <div class="next-action-row">
                <div class="action-label">Next Steps & Actions</div>
                <div class="action-buttons">
                    <button class="btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        Call Jan Now
                    </button>
                    <button class="btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        Schedule Appointment
                    </button>
                </div>
            </div>

            <div class="expand-arrow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
        </div>
    </div>

</body>
</html>
