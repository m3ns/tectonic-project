PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; the server refuses to start with the placeholder.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (e.g. 15m, 1h)
JWT_TTL=15m
FRONTEND_ORIGIN=http://localhost:5173
# At least 8 characters; the server refuses to start with the placeholder.
DEMO_PASSWORD=change-me
# Demo endpoints (replay). Must be false/unset when NODE_ENV=production (server refuses to start otherwise).
DEMO_MODE=true
SILENT_CUSTOMERS=45
# Which proxies to trust for req.ip / X-Forwarded-For. Default "loopback" (the Vite dev proxy).
# Use a hop count (e.g. 1) behind a real reverse proxy, or false to trust nothing.
TRUST_PROXY=loopback
# Global per-IP requests per minute (default 1000) and login lockout duration in ms (default 60000).
API_RATE_LIMIT=1000
LOCKOUT_MS=60000
