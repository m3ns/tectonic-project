PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; the server refuses to start with the placeholder.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (e.g. 15m, 1h)
JWT_TTL=15m
FRONTEND_ORIGIN=http://localhost:5173
# At least 8 characters; the server refuses to start with the placeholder.
DEMO_PASSWORD=change-me
# Demo endpoints (replay). Must be false/unset when NODE_ENV=production (server refuses to start otherwise).
DEMO_MODE=true
SILENT_CUSTOMERS=45
# Set to the number of reverse proxy hops (e.g. 1) when behind a proxy; default false.
TRUST_PROXY=false
